# =============================================================================
# Recruitment Assistant — Root Environment Variables (Docker Compose)
# =============================================================================
# This file is used by Docker Compose via `env_file: .env` for both services.
# Copy this file to .env and fill in your values before running docker compose up.
# .env is gitignored and must NEVER be committed to version control.
# =============================================================================

# Anthropic Enterprise API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LinkedIn li_at session cookie
# To obtain:
#   1. Log into LinkedIn in your browser (Chrome recommended).
#   2. Open DevTools (F12 or Cmd+Option+I on Mac).
#   3. Navigate to Application tab > Storage > Cookies > https://www.linkedin.com
#   4. Find the cookie named "li_at" and copy its Value field.
# WARNING: This cookie authenticates as your LinkedIn account. Keep it secret.
#   Treat it with the same sensitivity as a password. Refresh it when the session expires.
#   If exposed, log out of LinkedIn on the affected device immediately.
# IMPORTANT: Using this cookie for browser automation may violate LinkedIn's Terms of Service.
LI_AT=your_li_at_cookie_value_here

# Optional: CrewAI storage directory (for run-level storage if memory is ever enabled)
# memory=False for all agents at MVP (ADR-05). Uncomment only if memory=True is enabled.
# CREWAI_STORAGE_DIR=.crewai_storage
