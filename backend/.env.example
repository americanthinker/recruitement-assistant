# =============================================================================
# Recruitment Assistant — Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values before starting the application.
# .env is gitignored and must NEVER be committed to version control.
# =============================================================================

# ------------------------------------------------------------------------------
# REQUIRED — Application will fail to start if these are missing (PRD P0-7)
# ------------------------------------------------------------------------------

# Anthropic Enterprise API key
# Obtain from: https://console.anthropic.com/ under your organization's Enterprise account.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LinkedIn li_at session cookie
# To obtain:
#   1. Log into LinkedIn in your browser (Chrome recommended).
#   2. Open DevTools (F12 or Cmd+Option+I on Mac).
#   3. Navigate to Application tab > Storage > Cookies > https://www.linkedin.com
#   4. Find the cookie named "li_at" and copy its Value field.
# WARNING: This cookie authenticates as your LinkedIn account.
#   - Keep it secret — treat it with the same sensitivity as a password.
#   - It grants full access to your LinkedIn session.
#   - Refresh it when the session expires (typically after several months).
#   - If exposed (e.g., accidentally logged), log out of LinkedIn on the affected
#     device immediately to invalidate the cookie.
# IMPORTANT: Using this cookie for browser automation may violate LinkedIn's Terms of Service.
#   The risk of automated session detection and account action is accepted for MVP use.
#   See the LinkedIn ToS risk acknowledgment in the application UI before first run.
LI_AT=your_li_at_cookie_value_here

# ------------------------------------------------------------------------------
# OPTIONAL — Override defaults for tuning run behavior
# ------------------------------------------------------------------------------

# Maximum number of candidates to retrieve per run (default: 20, range: 5-50)
MAX_RESULTS=20

# Selenium inter-request delay range in seconds (randomized within this range)
# Increase to reduce LinkedIn session detection risk; decrease to speed up sourcing.
INTER_REQUEST_DELAY_MIN=2
INTER_REQUEST_DELAY_MAX=4

# Maximum number of LinkedIn page loads per run (default: max_results + 5)
# Prevents runaway navigation if sourcing encounters many pagination steps.
MAX_PAGE_LOADS_PER_RUN=25

# Directory for structured run log JSON files (default: logs)
# Path is relative to the backend service root.
LOG_DIR=logs

# Enable verbose CrewAI lifecycle logging (default: true for development)
# Set to false in production to reduce log noise.
VERBOSE_CREW=true

# CrewAI storage directory — only needed if memory=True is ever enabled for an agent.
# memory=False for all agents at MVP (ADR-05). Uncomment if memory is enabled in a future milestone.
# CREWAI_STORAGE_DIR=.crewai_storage
